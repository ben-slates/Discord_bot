# Discord bot credentials
BOT_TOKEN=

# Leave blank in production: commands are registered globally for every guild.
# Optional development-only fast sync target(s), comma-separated.
DEV_GUILD_IDS=

# One-time migration aid only if legacy XP rows cannot be associated with a
# single existing guild_config row. Do not set for normal operation.
LEGACY_XP_GUILD_ID=

# Database (leave blank to use sqlite:///./rynex.db)
DATABASE_URL=

# Google Gemini API key used by the support AI and test_models.py
GEMINI_API_KEY=
SECRET_KEY = 
ALGORITHM = 
ACCESS_TOKEN_EXPIRE_MINUTES =
